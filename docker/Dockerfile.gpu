# LingkodAI full pipeline image: GPU required.
#
# STATUS: built and import-checked, NOT verified running inference in a
# container. JOJIE is a shared JupyterHub and cannot run Docker, so GPU
# verification happens there through the lingkod-e2e conda env, built from the
# same pyproject.toml this image installs from.
#
# Build (from the repo root; building needs no GPU):
#   docker build -f docker/Dockerfile.gpu -t lingkodai-gpu .
# Run (needs NVIDIA driver + nvidia-container-toolkit on the host). HF_TOKEN
# comes from .env, never typed on the command line:
#   docker run --rm --gpus all --env-file .env -v lingkodai-hf:/data/hf lingkodai-gpu
#
# Weights are NOT baked in: roughly 45 GB across the seven models. They download
# to /data/hf on first boot. Mount a volume there or every restart re-downloads.
#
# Two one-time steps before the first real run, the same as outside a
# container (README, "Setting up the GPU pipeline"). Their output goes under
# the mounted volume so it persists:
#   docker run --rm --env-file .env -v lingkodai-hf:/data/hf lingkodai-gpu \
#       python scripts/patch_asr_tokenizers.py --out /data/hf/asr_patched
#   docker run --rm --env-file .env -v lingkodai-hf:/data/hf lingkodai-gpu \
#       python scripts/fetch_eval_assets.py --out /data/hf/eval_assets
# Then add ASR_CEB/FIL/ENG and TTS_REF_DIR, as printed (paths under /data/hf),
# to .env. The patched ASR copies symlink into the HF cache on the same
# volume, so they only resolve with that volume mounted.
#
# Branch tts-cpp: the image also carries the qwentts.cpp tts-server for the
# `--tts-backend cpp` Stage 7 (README, "Stage 7 on qwentts.cpp"), built in the
# first stage below and import-checked (its shared libraries resolve) only.
# Its GGUF weights are not baked in either:
#   docker run --rm --env-file .env -v lingkodai-hf:/data/hf lingkodai-gpu \
#       python scripts/fetch_qwentts_weights.py --out /data/hf/gguf
# then QWENTTS_TALKER_GGUF and QWENTTS_CODEC_GGUF in .env (see .env.example).

# --- Stage 1: qwentts.cpp tts-server --------------------------------------
# Built from source because upstream's prebuilt images cannot carry
# patches/qwentts/. Ubuntu 22.04: its glibc (2.35) is older than the runtime
# image's Debian bookworm (2.36), so the binary runs there. CUDA 12.6 matches
# the cu126 torch wheels, whose CUDA libraries the binary uses at run time.
# GGML_NATIVE=OFF: no -march=native, so the binary runs on any x86-64 CPU.
# The CUDA driver stub stands in for libcuda.so.1 only while the build
# script runs the binaries' usage and C ABI checks (no GPU at build time).
FROM nvidia/cuda:12.6.3-devel-ubuntu22.04 AS qwentts

RUN apt-get update && apt-get install -y --no-install-recommends \
        git cmake build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY scripts/build_qwentts.sh scripts/
COPY patches/qwentts/ patches/qwentts/
RUN ln -s /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1 \
    && LD_LIBRARY_PATH=/usr/local/cuda/lib64/stubs:${LD_LIBRARY_PATH} \
       QWENTTS_DIR=/opt/qwentts.cpp QWENTTS_CMAKE_ARGS="-DGGML_NATIVE=OFF" \
       bash scripts/build_qwentts.sh

# --- Stage 2: the pipeline --------------------------------------------------
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/data/hf \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# ffmpeg: src/audio.py shells out to it to resample any input to 16 kHz mono.
# sox: qwen_tts warns on import without it.
# git: some HF model repos resolve through git during download.
# libgomp1, libstdc++6: runtime libraries of the qwentts.cpp binaries.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg sox git libgomp1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# torch FIRST, from the PyTorch cu126 wheel index, not PyPI. The PyPI torch
# wheel ships a different CUDA build and would either fail on the host driver or
# silently fall back to CPU. cu126 matches JOJIE's lingkod-e2e env.
#
# Not pinned. The verified JOJIE runs used torch 2.14.0+cu126 with
# transformers 4.57.3; torch and torchaudio are left unpinned here so the pair
# always resolves to matching builds from the same index.
RUN pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu126 \
        torch torchaudio

COPY pyproject.toml README.md ./
# The gpu extra pulls qwen-tts==0.1.1, which pins transformers==4.57.3 and
# accelerate==1.12.0. If pip reports a conflict here, that is a real finding:
# surface it, do not loosen the qwen-tts pin to make the build pass.
RUN pip install --no-cache-dir ".[gpu]"

COPY src/ ./src/
COPY scripts/ ./scripts/
COPY models/ ./models/
COPY data/prc_chunks/ ./data/prc_chunks/
COPY data/init_set_ds6.json ./data/init_set_ds6.json

# Same reason as the CPU image: the vendored frontend modules import each other
# by bare top-level name and must not be edited.
ENV PYTHONPATH=/app:/app/src/tts_frontend

# qwentts.cpp build, at the path it was built in: the binaries find their
# ggml libraries through an absolute RUNPATH. libcudart and libcublas come
# from the cu126 torch wheels' nvidia packages; libcuda.so.1 is the host
# driver, mounted at run time by the NVIDIA container toolkit.
COPY --from=qwentts /opt/qwentts.cpp/build /opt/qwentts.cpp/build
ENV QWENTTS_SERVER_BIN=/opt/qwentts.cpp/build/tts-server \
    LD_LIBRARY_PATH=/usr/local/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:/usr/local/lib/python3.12/site-packages/nvidia/cublas/lib
RUN missing="$(ldd "$QWENTTS_SERVER_BIN" | grep 'not found' | grep -v 'libcuda\.so\.1' || true)"; \
    if [ -n "$missing" ]; then echo "tts-server is missing libraries:"; echo "$missing"; exit 1; fi; \
    cat /opt/qwentts.cpp/build/BUILD_INFO.txt; \
    echo "tts-server libraries resolve (libcuda.so.1 comes from the host driver at run time)"

# Import check only. This runs at build time on a machine with no GPU, so it
# must not touch CUDA or load any weights.
RUN python -c "import torch, transformers; \
import shared_domain_frontend, ceb_full_pipeline; \
from lingkod_tts_utils import prep_tts_text; \
import fasttext; \
import src.tts_cpp; \
print('torch', torch.__version__, '| transformers', transformers.__version__); \
print('imports OK (no GPU touched)')"

RUN mkdir -p /data/hf /app/outputs

# No CMD that starts work by itself: this image is driven by an explicit
# command, so a stray `docker run` cannot kick off hours of GPU synthesis.
# Print the environment the caller landed in instead.
CMD ["python", "-c", "import torch; print('CUDA available:', torch.cuda.is_available()); print('arch list:', torch.cuda.get_arch_list() if torch.cuda.is_available() else 'n/a'); print('Run scripts/run_conversation.py --help for the CLI.')"]

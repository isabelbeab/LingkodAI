# Copy to .env and fill in. .env is gitignored and must never be committed.
# On Fly these are set with `fly secrets set NAME=value`, not in fly.toml:
# anything in fly.toml is committed to git and readable by anyone with the repo.

# --- GPU pipeline only. The CPU demo image never needs this. ---------------
# Read access to the private ASR checkpoints
# (beabucayan/lingkodai-whisper-{ceb,fil,eng}) and the TTS reference clips.
#
# Use a token minted from YOUR OWN Hugging Face account once Bea grants it
# collaborator access. If that is not possible before the deadline, a
# FINE-GRAINED token scoped read-only to just those repos is the interim: a leak
# then exposes three model repos rather than a whole account. Never a token from
# a shared account login, and never in a Fly secret.
HF_TOKEN=

# Private HF repo holding the three locked TTS reference clips plus
# ref_config.json. The clips are PLD speaker audio under a research-only
# CC-BY-NC licence and are never committed to a public repo.
TTS_REF_REPO=

# Override the ASR checkpoint repos if loading from local JOJIE paths at
# /mnt/processed/private/msds2026/cpt5/best_checkpoints/{lang}/ instead of the
# Hub. src/asr.py reads these; leave blank to use its defaults.
ASR_CEB=
ASR_FIL=
ASR_ENG=

# --- CPU demo app -----------------------------------------------------------
# Shared password for the public Fly URL. The demo plays synthesized speech in a
# cloned PLD research speaker's voice, so the page is gated rather than fully
# public. Pick a real value; do not ship "changeme".
APP_PASSWORD=

# Where the full pipeline runs, once a GPU host exists (RunPod, Modal, or a
# laptop with a GPU). Leave blank and the app stays in demo mode: text frontend
# and text language identification live, everything else pre-rendered.
GPU_BACKEND_URL=

# --- Both images ------------------------------------------------------------
# Hugging Face cache location inside a container. Mount a volume here or every
# restart re-downloads GlotLID (around 1.2 GB) and, on the GPU side, the models.
HF_HOME=/data/hf

# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- GPU pipeline only. The CPU demo image never needs this. ---------------
# Read access to the private ASR checkpoints
# (beabucayan/lingkodai-whisper-{ceb,fil,eng}).
#
# Use a token from your own Hugging Face account with collaborator access to
# those repos, created as a FINE-GRAINED token scoped read-only to just them, so
# a leak exposes three model repos rather than a whole account. Never use a
# token from a shared account login.
HF_TOKEN=

# Directory holding the three locked TTS reference clips (PLD speaker audio,
# CC-BY-NC research-only, never committed). Searched recursively by filename,
# so the layout under it does not matter.
TTS_REF_DIR=

# Optional: load the ASR checkpoints from local directories instead of the
# Hub. src/asr.py reads these with os.environ.get(name, default), so an EMPTY
# value overrides the default with "" and loading fails. Leave them commented
# out to use the Hub defaults; uncomment only with a real path or repo id.
# ASR_CEB=
# ASR_FIL=
# ASR_ENG=

# --- CPU demo app -----------------------------------------------------------
# Password for the demo page. The demo plays synthesized speech in a cloned PLD
# research speaker's voice, so the page is gated rather than fully public. Pick
# a real value; do not use "changeme" outside local testing.
APP_PASSWORD=

# --- Both images ------------------------------------------------------------
# Hugging Face cache location inside a container. Mount a volume here or every
# restart re-downloads GlotLID (around 1.2 GB) and, on the GPU side, the models.
# Set by the Dockerfiles already. Leave commented on a machine that is not a
# container: /data does not exist there and downloads fail.
# HF_HOME=/data/hf

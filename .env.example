# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- GPU pipeline only. The CPU demo image never needs this. ---------------
# Read access to the private repos in the lingkodai Hugging Face org: the ASR
# checkpoints (models lingkodai/lingkodai-whisper-{ceb,fil,eng}) and the eval
# assets (dataset lingkodai/lingkodai-eval-assets).
#
# Use a token from your own Hugging Face account as a member of the lingkodai
# org, created as a FINE-GRAINED token scoped read-only to just those four
# repos, so a leak exposes four repos rather than a whole account. Never use a
# token from a shared account login.
HF_TOKEN=

# Directory holding the three locked TTS reference clips (PLD speaker audio,
# CC-BY-NC research-only, never committed). Searched recursively by filename,
# so the layout under it does not matter. scripts/fetch_eval_assets.py
# downloads them and prints the value to put here (<its --out>/tts_ref).
TTS_REF_DIR=

# Required for the GPU pipeline: the patched local copies of the ASR
# checkpoints. The Hub copies do NOT load as published under the pinned
# transformers 4.57.3 (CHANGELOG.md, 2026-09-22), so the defaults in
# src/asr.py fail. Run scripts/patch_asr_tokenizers.py once and paste the
# three absolute paths it prints. Keep them commented until then: src/asr.py
# reads these with os.environ.get(name, default), so an EMPTY value overrides
# the default with "" and loading fails.
# ASR_CEB=
# ASR_FIL=
# ASR_ENG=

# --- CPU demo app -----------------------------------------------------------
# Password for the demo page. The demo plays synthesized speech in a cloned PLD
# research speaker's voice, so the page is gated rather than fully public. Pick
# a real value; do not use "changeme" outside local testing.
APP_PASSWORD=

# --- Both images ------------------------------------------------------------
# Hugging Face cache location inside a container. Mount a volume here or every
# restart re-downloads GlotLID (around 1.2 GB) and, on the GPU side, the models.
# Set by the Dockerfiles already. Leave commented on a machine that is not a
# container: /data does not exist there and downloads fail.
# HF_HOME=/data/hf
